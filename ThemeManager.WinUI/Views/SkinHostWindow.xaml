<Window
    x:Class="ThemeManager.WinUI.Views.SkinHostWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views">

    <!--
        Meters are added to RootCanvas programmatically in the code-behind (one TextBlock per
        String meter, one Border-pair per Bar meter) rather than via XAML data templates. That
        trades a little XAML purity for code that's much easier to hand-verify without a live
        WinUI3 designer — see the remarks at the top of SkinHostWindow.xaml.cs.
    -->
    <Border x:Name="CardBorder" CornerRadius="{StaticResource CornerRadiusLarge}">
        <Canvas x:Name="RootCanvas" Background="Transparent" />
    </Border>
</Window>
