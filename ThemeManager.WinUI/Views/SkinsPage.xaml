<Page
    x:Class="ThemeManager.WinUI.Views.SkinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views"
    xmlns:skins="using:ThemeManager.Core.Skins"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Page header -->
            <RowDefinition Height="*" />      <!-- Widget grid -->
            <RowDefinition Height="Auto" />   <!-- Status bar  -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             Page header
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Padding="32,28,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Widgets"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Rainmeter-style desktop widgets. Toggle, tint, lock, and drag the built-ins here — click Edit to change what a widget actually shows."
                           Style="{StaticResource CaptionStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Widget"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Top"
                    Click="NewWidgetButton_Click" />
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             Widget grid
        ══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      Padding="32,0,32,32"
                      VerticalScrollBarVisibility="Auto">

            <ItemsRepeater x:Name="SkinsRepeater"
                           ItemsSource="{x:Bind ViewModel.Skins, Mode=OneWay}">

                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300"
                                       MinColumnSpacing="16"
                                       MinRowSpacing="16" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="skins:SkinDefinition">

                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Name + Enabled switch -->
                                    <RowDefinition Height="Auto" /> <!-- Opacity slider        -->
                                    <RowDefinition Height="Auto" /> <!-- Click-through / Lock  -->
                                    <RowDefinition Height="Auto" /> <!-- Reset position        -->
                                </Grid.RowDefinitions>

                                <!-- Name + Enabled -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Name, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1"
                                                  Tag="{x:Bind}"
                                                  IsOn="{x:Bind Enabled, Mode=OneWay}"
                                                  Style="{StaticResource CozyToggleStyle}"
                                                  OnContent="On" OffContent="Off"
                                                  Toggled="EnabledToggle_Toggled" />
                                </Grid>

                                <!-- Opacity -->
                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Text="Card opacity" Style="{StaticResource CaptionStyle}" />
                                    <Slider Tag="{x:Bind}"
                                            Minimum="0.2" Maximum="1.0" StepFrequency="0.05"
                                            Value="{x:Bind Opacity, Mode=OneWay}"
                                            Foreground="{StaticResource PrimaryAccentBrush}"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                </StackPanel>

                                <!-- Click-through / Locked -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="20">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Click-through" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch Tag="{x:Bind}"
                                                      IsOn="{x:Bind ClickThrough, Mode=OneWay}"
                                                      Style="{StaticResource CozyToggleStyle}"
                                                      OnContent="" OffContent=""
                                                      Toggled="ClickThroughToggle_Toggled" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Locked" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch Tag="{x:Bind}"
                                                      IsOn="{x:Bind Locked, Mode=OneWay}"
                                                      Style="{StaticResource CozyToggleStyle}"
                                                      OnContent="" OffContent=""
                                                      Toggled="LockedToggle_Toggled" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Reset position / Edit -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Reset position"
                                            Tag="{x:Bind}"
                                            Click="ResetPositionButton_Click" />
                                    <Button Content="Edit"
                                            Tag="{x:Bind}"
                                            Click="EditButton_Click" />
                                </StackPanel>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>

            </ItemsRepeater>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════
             Status bar
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,10,32,10">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}" />
        </Border>

    </Grid>
</Page>
