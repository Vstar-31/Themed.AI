<Page
    x:Class="ThemeManager.WinUI.Views.SkinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views"
    xmlns:skins="using:ThemeManager.Core.Skins"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="32,28,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Widgets"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Rainmeter-style desktop widgets. Normal desktop layering by default — opt into Stay on top only when you need it. Toggle, tint, lock, and drag widgets here."
                           Style="{StaticResource CaptionStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock Text="Master visibility" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"/>
                <ToggleSwitch x:Name="MasterVisibilityToggle" IsOn="True" Toggled="MasterVisibilityToggle_Toggled" Style="{StaticResource CozyToggleStyle}" OnContent="" OffContent="" />
            </StackPanel>
            <Button Grid.Column="2" Content="+ New Widget"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Top"
                    Click="NewWidgetButton_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="32,0,32,32"
                      VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="SkinsRepeater"
                           ItemsSource="{x:Bind ViewModel.Skins, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300"
                                       MinColumnSpacing="16"
                                       MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="skins:SkinDefinition">
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Name}"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1"
                                                  Tag="{x:Bind}"
                                                  IsOn="{x:Bind Enabled}"
                                                  Style="{StaticResource CozyToggleStyle}"
                                                  OnContent="On" OffContent="Off"
                                                  Toggled="EnabledToggle_Toggled" />
                                </Grid>

                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Text="Card background" Style="{StaticResource CaptionStyle}" />
                                    <Slider Tag="{x:Bind}"
                                            Minimum="0" Maximum="1.0" StepFrequency="0.05"
                                            Value="{x:Bind Opacity}"
                                            Foreground="{StaticResource PrimaryAccentBrush}"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Click-through" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch Tag="{x:Bind}"
                                                      IsOn="{x:Bind ClickThrough}"
                                                      Style="{StaticResource CozyToggleStyle}"
                                                      OnContent="" OffContent=""
                                                      Toggled="ClickThroughToggle_Toggled" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Stay on top" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch Tag="{x:Bind}"
                                                      IsOn="{x:Bind AlwaysOnTop}"
                                                      Style="{StaticResource CozyToggleStyle}"
                                                      OnContent="" OffContent=""
                                                      Toggled="AlwaysOnTopToggle_Toggled" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Locked" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch Tag="{x:Bind}"
                                                      IsOn="{x:Bind Locked}"
                                                      Style="{StaticResource CozyToggleStyle}"
                                                      OnContent="" OffContent=""
                                                      Toggled="LockedToggle_Toggled" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Reset" Tag="{x:Bind}" Click="ResetPositionButton_Click" />
                                        <Button Content="Edit" Tag="{x:Bind}" Click="EditButton_Click" />
                                        <Button Content="Delete" Tag="{x:Bind}" Style="{StaticResource DangerButtonStyle}" Click="DeleteButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,10,32,10">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}" />
        </Border>
    </Grid>
</Page>
