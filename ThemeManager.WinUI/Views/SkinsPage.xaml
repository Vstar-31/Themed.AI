<Page
    x:Class="ThemeManager.WinUI.Views.SkinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views"
    xmlns:skins="using:ThemeManager.Core.Skins"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="32,28,32,16" Spacing="12">
            <TextBlock Text="Widgets" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Desktop tools you can arrange, customize and save. Use Studio to apply a complete world." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ToggleSwitch x:Name="MasterVisibilityToggle" Header="Desktop widgets" IsOn="True" Toggled="MasterVisibilityToggle_Toggled" Style="{StaticResource CozyToggleStyle}" OnContent="Visible" OffContent="Hidden" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="Add widget" Style="{StaticResource PrimaryButtonStyle}">
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Remix a starter…" Click="BrowseTemplates_Click"/>
                            <MenuFlyoutItem Text="New blank widget" Click="NewWidgetButton_Click" />
                            <MenuFlyoutItem Text="Generate with AI" Click="GenerateWidgetButton_Click" />
                            <MenuFlyoutItem Text="Import widget…" Click="ImportWidgetButton_Click" />
                        </MenuFlyout></Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Padding="32,0,32,32"
                      VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="SkinsRepeater"
                           ItemsSource="{x:Bind ViewModel.Skins, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout ItemsStretch="Fill" MinItemWidth="300"
                                       MinColumnSpacing="16"
                                       MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="skins:SkinDefinition">
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Name}" TextWrapping="Wrap" Height="48" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" Margin="0,0,8,0"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1"
                                                  Tag="{x:Bind}"
                                                  IsOn="{x:Bind Enabled}"
                                                  Style="{StaticResource CozyToggleStyle}"
                                                  OnContent="On" OffContent="Off"
                                                  Toggled="EnabledToggle_Toggled" />
                                </Grid>

                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Text="Card background" Style="{StaticResource CaptionStyle}" />
                                    <Slider Tag="{x:Bind}"
                                            Minimum="0" Maximum="1.0" StepFrequency="0.05"
                                            Value="{x:Bind Opacity}"
                                            Foreground="{StaticResource PrimaryAccentBrush}"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Click-through" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch Tag="{x:Bind}"
                                                      IsOn="{x:Bind ClickThrough}"
                                                      Style="{StaticResource CozyToggleStyle}"
                                                      OnContent="" OffContent=""
                                                      Toggled="ClickThroughToggle_Toggled" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Stay on top" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch Tag="{x:Bind}"
                                                      IsOn="{x:Bind AlwaysOnTop}"
                                                      Style="{StaticResource CozyToggleStyle}"
                                                      OnContent="" OffContent=""
                                                      Toggled="AlwaysOnTopToggle_Toggled" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" RowSpacing="12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Locked" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch Tag="{x:Bind}"
                                                      IsOn="{x:Bind Locked}"
                                                      Style="{StaticResource CozyToggleStyle}"
                                                      OnContent="" OffContent=""
                                                      Toggled="LockedToggle_Toggled" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Reset" Tag="{x:Bind}" Click="ResetPositionButton_Click" />
                                        <Button Content="Edit" Tag="{x:Bind}" Click="EditButton_Click" />
                                        <Button Content="Remix" Tag="{x:Bind}" Click="RemixWidget_Click"/>
                                        <Button Content="More" AutomationProperties.Name="More widget actions">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Export widget…" Tag="{x:Bind}" Click="ExportWidgetButton_Click" />
                                                    <MenuFlyoutItem Text="Delete" Tag="{x:Bind}" Click="DeleteButton_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,10,32,10">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                       Style="{StaticResource CaptionStyle}" />
        </Border>
    </Grid>
</Page>
