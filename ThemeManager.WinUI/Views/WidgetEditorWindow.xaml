<Window
    x:Class="ThemeManager.WinUI.Views.WidgetEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Widget Builder (WYSIWYG)">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Toolbox -->
        <Border Grid.Column="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="Gray" BorderThickness="0,0,1,0" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Toolbox" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Drag components onto the canvas" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                
                <Button Content="Text Meter (Time/Date)" HorizontalAlignment="Stretch" Click="OnAddTextMeterClicked" />
                <Button Content="Progress Bar (CPU/RAM)" HorizontalAlignment="Stretch" Click="OnAddBarMeterClicked" />
                <Button Content="Graph Line (History)" HorizontalAlignment="Stretch" Click="OnAddGraphMeterClicked" />
            </StackPanel>
        </Border>

        <!-- Canvas Area -->
        <Grid Grid.Column="1" Background="#202020">
            <TextBlock Text="Desktop Preview" Foreground="White" Opacity="0.3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="32" />
            
            <Canvas x:Name="WidgetCanvas" Background="Transparent" 
                    PointerPressed="OnCanvasPointerPressed" 
                    PointerMoved="OnCanvasPointerMoved" 
                    PointerReleased="OnCanvasPointerReleased">
                
                <!-- Mock Desktop Widget Background -->
                <Border x:Name="WidgetBounds" 
                        Canvas.Left="100" Canvas.Top="100" 
                        Width="300" Height="200" 
                        Background="#A0000000" CornerRadius="12" 
                        BorderBrush="White" BorderThickness="1">
                    <TextBlock Text="Skin Boundary" Foreground="White" Opacity="0.5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" />
                </Border>

            </Canvas>
        </Grid>

        <!-- Properties Panel -->
        <Border Grid.Column="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Properties" Style="{StaticResource SubtitleTextBlockStyle}" />
                
                <TextBlock Text="Select a meter on the canvas to edit its properties." Opacity="0.6" FontSize="12" TextWrapping="Wrap" x:Name="NoSelectionText" />

                <StackPanel x:Name="PropertiesPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Data Binding" />
                    <ComboBox x:Name="DataBindingCombo" HorizontalAlignment="Stretch" SelectionChanged="OnDataBindingChanged">
                        <ComboBoxItem Content="Time" />
                        <ComboBoxItem Content="Date" />
                        <ComboBoxItem Content="CPU Usage" />
                        <ComboBoxItem Content="RAM Usage" />
                    </ComboBox>
                    
                    <TextBlock Text="X Position" Margin="0,8,0,0" />
                    <Slider x:Name="PosXSlider" Minimum="0" Maximum="500" ValueChanged="OnPositionChanged" />
                    
                    <TextBlock Text="Y Position" />
                    <Slider x:Name="PosYSlider" Minimum="0" Maximum="500" ValueChanged="OnPositionChanged" />
                    
                    <TextBlock Text="Width" />
                    <Slider x:Name="WidthSlider" Minimum="10" Maximum="500" ValueChanged="OnSizeChanged" />
                    
                    <TextBlock Text="Height" />
                    <Slider x:Name="HeightSlider" Minimum="10" Maximum="200" ValueChanged="OnSizeChanged" />

                    <Button Content="Remove Meter" Foreground="Red" HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="OnRemoveMeterClicked" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
