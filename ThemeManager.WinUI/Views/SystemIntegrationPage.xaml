<Page
    x:Class="ThemeManager.WinUI.Views.SystemIntegrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer Padding="32,28,32,32"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Spacing="20">

            <StackPanel Spacing="4" Margin="{StaticResource SectionMargin}">
                <TextBlock Text="System Integration"
                           FontSize="{StaticResource FontSizeDisplay}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Let Themed.AI carry its visual language into Windows itself."
                           Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Current System State"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*"   />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   x:Name="ModeText"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Accent color"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border x:Name="AccentSwatch"
                                    Width="20" Height="20"
                                    CornerRadius="4"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" />
                            <TextBlock x:Name="AccentHexText"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Windows build"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   x:Name="BuildText"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Button Content="Refresh"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="RefreshButton_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Windows Appearance"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Spacing="2">
                        <ToggleSwitch x:Name="WindowsAppsToggle"
                                      Header="Sync Windows app appearance"
                                      Style="{StaticResource CozyToggleStyle}"
                                      IsOn="{x:Bind ViewModel.ActiveThemeApplyWindowsApps, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Switches supported Windows apps, including File Explorer, between Light and Dark mode to match this theme's palette."
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <ToggleSwitch x:Name="WallpaperToggle"
                                      Header="Set wallpaper when applying theme"
                                      Style="{StaticResource CozyToggleStyle}"
                                      IsOn="{x:Bind ViewModel.ActiveThemeApplyWallpaper, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Uses the wallpaper path stored in the active theme."
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Content="Browse Wallpaper…"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="BrowseWallpaperButton_Click"
                            HorizontalAlignment="Left" />

                    <Button Content="Apply Theme to System"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ApplyThemeButton_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}"
                    BorderBrush="#E8A87C">
                <StackPanel Spacing="16">
                    <Border Background="#FFF3E0"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="14,10,14,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="⚠️  Advanced – Use at your own risk"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="#7A4F00" />
                            <TextBlock FontSize="12"
                                       Foreground="#7A4F00"
                                       TextWrapping="Wrap">
                                The advanced controls below write Windows personalization values such as
                                the DWM accent. A sign-out or Explorer refresh can occasionally be needed.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ToggleSwitch x:Name="AdvancedToggle"
                                  Header="Enable advanced system tweaks"
                                  Style="{StaticResource CozyToggleStyle}"
                                  IsOn="{x:Bind ViewModel.AdvancedEnabled, Mode=TwoWay}" />

                    <ContentControl IsEnabled="{x:Bind ViewModel.AdvancedEnabled, Mode=OneWay}">
                        <StackPanel Spacing="12"
                                    Opacity="{x:Bind ViewModel.AdvancedEnabledOpacity, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Apply accent primary color to Windows"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="Writes to HKCU\Software\Microsoft\Windows\DWM." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Apply Accent to Windows"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ApplyAccentButton_Click" />
                                <Button Content="Reset to Windows Default"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="ResetAccentButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SidebarBackgroundBrush}"
                    CornerRadius="{StaticResource CornerRadiusSmall}"
                    Padding="16,10,16,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing x:Name="BusyRing"
                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Width="16" Height="16"
                                  Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
