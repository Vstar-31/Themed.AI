<Page
    x:Class="ThemeManager.WinUI.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views"
    xmlns:models="using:ThemeManager.Core.Models"
    xmlns:skins="using:ThemeManager.Core.Skins"
    Background="{StaticResource AppBackgroundBrush}">

    <!-- Converters declared FIRST so they are available during DataTemplate parsing -->
    <Page.Resources>
        <local:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter" />
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <local:HexToBrushConverter        x:Key="HexToBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Page header -->
            <RowDefinition Height="*" />      <!-- Pack list   -->
            <RowDefinition Height="Auto" />   <!-- Status bar  -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             Page header
        ══════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Padding="32,28,32,16" Spacing="2">
            <TextBlock Text="Gallery"
                       FontSize="{StaticResource FontSizeDisplay}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Bundled themes and widgets — add whatever looks good to your own library"
                       Style="{StaticResource CaptionStyle}" />
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════════
             Pack list
        ══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      Padding="32,0,32,32"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="28">

                <!-- Empty state — no packs shipped or all failed to load -->
                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="No packs found"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Drop a pack .json file into Assets\CommunityPacks next to the app and restart."
                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- One section per pack -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Packs}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="28" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:CommunityPack">

                            <StackPanel Spacing="16">

                                <!-- Pack header -->
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                                   FontSize="{StaticResource FontSizeTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Author, Mode=OneTime}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description, Mode=OneTime}"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Themes in this pack -->
                                <ItemsRepeater ItemsSource="{x:Bind Themes, Mode=OneTime}"
                                               Visibility="{x:Bind Themes.Count, Mode=OneTime,
                                                   Converter={StaticResource CountToVisibilityConverter}}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="300" MinColumnSpacing="16" MinRowSpacing="16" />
                                    </ItemsRepeater.Layout>

                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:CozyTheme">
                                            <Border Style="{StaticResource CardStyle}" Margin="0">
                                                <Grid RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" /> <!-- Palette strip -->
                                                        <RowDefinition Height="Auto" /> <!-- Name + desc   -->
                                                        <RowDefinition Height="Auto" /> <!-- Action        -->
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Height="12" CornerRadius="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="6,0,0,6"
                                                                Background="{x:Bind BackgroundBase, Mode=OneTime, Converter={StaticResource HexToBrushConverter}}" />
                                                        <Border Grid.Column="1"
                                                                Background="{x:Bind BackgroundAlt, Mode=OneTime, Converter={StaticResource HexToBrushConverter}}" />
                                                        <Border Grid.Column="2"
                                                                Background="{x:Bind Surface, Mode=OneTime, Converter={StaticResource HexToBrushConverter}}" />
                                                        <Border Grid.Column="3"
                                                                Background="{x:Bind AccentPrimary, Mode=OneTime, Converter={StaticResource HexToBrushConverter}}" />
                                                        <Border Grid.Column="4" CornerRadius="0,6,6,0"
                                                                Background="{x:Bind AccentStrong, Mode=OneTime, Converter={StaticResource HexToBrushConverter}}" />
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Spacing="4">
                                                        <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                                                   FontSize="{StaticResource FontSizeSubtitle}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind Description, Mode=OneTime}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <Button Grid.Row="2"
                                                            Content="Add to My Themes"
                                                            Tag="{x:Bind}"
                                                            Click="AddThemeButton_Click"
                                                            Style="{StaticResource PrimaryButtonStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <!-- Widgets in this pack -->
                                <ItemsRepeater ItemsSource="{x:Bind Widgets, Mode=OneTime}"
                                               Visibility="{x:Bind Widgets.Count, Mode=OneTime,
                                                   Converter={StaticResource CountToVisibilityConverter}}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="240" MinColumnSpacing="16" MinRowSpacing="16" />
                                    </ItemsRepeater.Layout>

                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="skins:SkinDefinition">
                                            <Border Style="{StaticResource CardStyle}" Margin="0">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                                                   FontSize="{StaticResource FontSizeSubtitle}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="Widget"
                                                                   Style="{StaticResource CaptionStyle}" />
                                                    </StackPanel>
                                                    <Button Content="Add Widget"
                                                            Tag="{x:Bind}"
                                                            Click="AddWidgetButton_Click"
                                                            Style="{StaticResource PrimaryButtonStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════
             Status bar
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,10,32,10">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}" />
        </Border>

    </Grid>
</Page>
