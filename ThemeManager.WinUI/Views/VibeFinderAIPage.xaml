<Page
    x:Class="ThemeManager.WinUI.Views.VibeFinderAIPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid SizeChanged="MediaLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="ConnectionButton" Content="Connection &amp; widgets" Margin="16,10"
                Click="ToggleConnection_Click"/>
        <SplitView x:Name="MediaSplit" Grid.Row="1" OpenPaneLength="320"
                   DisplayMode="Overlay" IsPaneOpen="False"
                   PaneBackground="{StaticResource AppBackgroundBrush}">
        <SplitView.Pane>
        <ScrollViewer Padding="20" HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="20">
                <Button x:Name="CloseConnectionButton" Content="Back to player" Click="ToggleConnection_Click"/>
                <TextBlock Text="VibeFinder AI" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Make the desktop react to what you are listening to." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>

                <StackPanel Spacing="10">
                    <TextBlock Text="Connection" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Your account details are saved on this device and sent to VibeFinder to sign in. Widgets share this session." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                    <HyperlinkButton Content="Open web version ↗" NavigateUri="https://vfaithemed.netlify.app/app"/>
                    <TextBox x:Name="UsernameBox" Header="Username" PlaceholderText="Your VibeFinder username"/>
                    <PasswordBox x:Name="PasswordBox" Header="Password" PlaceholderText="Your VibeFinder password"/>
                    <TextBox x:Name="PromptBox" Header="Vibe Prompt" Text="$theme" PlaceholderText="e.g. cozy rainy afternoon, or $theme"/>
                    <Button Content="Save &amp; Apply" Click="SaveCredentials_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Saved!" Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"/>
                </StackPanel>

                <MenuFlyoutSeparator Margin="0,2,0,2"/>

                <StackPanel Spacing="10">
                    <TextBlock Text="Desktop Widgets" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Three curated layouts — choose the amount of music UI you want floating over Windows." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                    <ToggleSwitch x:Name="TogglePrimary" Header="VibeFinder Primary" Toggled="WidgetToggle_Toggled" Tag="VibeFinder Primary"/>
                    <ToggleSwitch x:Name="ToggleMinimal" Header="VibeFinder Minimal" Toggled="WidgetToggle_Toggled" Tag="VibeFinder Minimal"/>
                    <ToggleSwitch x:Name="TogglePlaylist" Header="VibeFinder Playlist" Toggled="WidgetToggle_Toggled" Tag="VibeFinder Playlist"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </SplitView.Pane>
        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
            <WebView2 x:Name="VibeFinderWebView"/>
        </Border>
        </SplitView>
    </Grid>
</Page>
