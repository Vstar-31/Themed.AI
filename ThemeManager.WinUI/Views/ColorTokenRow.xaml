<UserControl
    x:Class="ThemeManager.WinUI.Views.ColorTokenRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views">

    <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"    />   <!-- Label        -->
            <ColumnDefinition Width="32"   />   <!-- Color swatch -->
            <ColumnDefinition Width="96"   />   <!-- Hex TextBox  -->
            <ColumnDefinition Width="28"   />   <!-- Reset button -->
        </Grid.ColumnDefinitions>

        <!-- Label -->
        <TextBlock Grid.Column="0"
                   x:Name="LabelText"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis" />

        <!-- Color swatch (opens ColorPicker flyout on click) -->
        <Button Grid.Column="1"
                x:Name="SwatchButton"
                Width="32" Height="32"
                Padding="0"
                BorderThickness="0"
                CornerRadius="{StaticResource CornerRadiusSmall}"
                Click="SwatchButton_Click">
            <Button.Flyout>
                <Flyout x:Name="PickerFlyout"
                        Placement="BottomEdgeAlignedLeft">
                    <ColorPicker x:Name="InlinePicker"
                                 IsAlphaEnabled="False"
                                 IsHexInputVisible="True"
                                 Width="300"
                                 ColorChanged="InlinePicker_ColorChanged" />
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- Hex TextBox -->
        <TextBox Grid.Column="2"
                 x:Name="HexBox"
                 Style="{StaticResource CozyTextBoxStyle}"
                 MaxLength="7"
                 CharacterCasing="Upper"
                 TextChanged="HexBox_TextChanged"
                 VerticalAlignment="Center" />

        <!-- Reset to default button -->
        <Button Grid.Column="3"
                x:Name="ResetButton"
                Width="28" Height="28"
                Padding="0"
                BorderThickness="0"
                Background="Transparent"
                CornerRadius="{StaticResource CornerRadiusSmall}"
                ToolTipService.ToolTip="Reset to default"
                Click="ResetButton_Click">
            <TextBlock Text="↺" FontSize="14"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Button>

    </Grid>
</UserControl>
