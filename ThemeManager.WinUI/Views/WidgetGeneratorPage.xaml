<Page
    x:Class="ThemeManager.WinUI.Views.WidgetGeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="32,28,32,16">
            <StackPanel Spacing="2">
                <TextBlock Text="Widget Generator"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Describe the widget you want in plain English — the same offline NLP approach as the theme Vibe generator, just for measures and layout instead of color."
                           Style="{StaticResource CaptionStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <!-- Content -->
        <Grid Grid.Row="1" Margin="32,0,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Generator -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Padding="0,0,0,32">
                    <!-- Prompt input -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Describe your widget" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBox Text="{x:Bind ViewModel.PromptText, Mode=TwoWay}"
                                     PlaceholderText="e.g. &quot;a big CPU and memory graph in the top right&quot;"
                                     AcceptsReturn="False"
                                     Style="{StaticResource CozyTextBoxStyle}"
                                     Height="72" FontSize="15" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Generate Widget"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.CanGenerate, Mode=OneWay}"
                                        Click="GenerateButton_Click" />
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                              Width="24" Height="24"
                                              Foreground="{StaticResource PrimaryAccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Suggestions -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Try one of these" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SuggestionChips}">
                                <ItemsRepeater.Layout>
                                    <LinedFlowLayout MinItemSpacing="8" LineSpacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border CornerRadius="{StaticResource CornerRadiusPill}"
                                                Background="{StaticResource SidebarBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                Padding="14,7,14,7">
                                            <Button Background="Transparent" BorderThickness="0"
                                                    Padding="0" Content="{x:Bind}"
                                                    FontSize="12"
                                                    Foreground="{StaticResource PrimaryAccentBrush}"
                                                    Tag="{x:Bind}"
                                                    Click="Chip_Click" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Result card -->
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.GeneratedSkin.Name, Mode=OneWay, FallbackValue=''}"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Widget generated successfully."
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.UsedFallbackDisplay, Mode=OneWay}"
                                       Foreground="{StaticResource StrongAccentBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="🎨  Open in Editor"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OpenEditorButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: Insights panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Padding="0,0,0,32">
                    <TextBlock Text="Pipeline Insights" Style="{StaticResource SectionHeaderStyle}" />

                    <!-- Matched keywords -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Matched keywords" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.MatchedWordsDisplay, Mode=OneWay}"
                                       FontSize="11" FontFamily="Consolas"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Fuzzy corrections -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Fuzzy corrections (typos)" Style="{StaticResource CaptionStyle}" />
                                <Border Background="{StaticResource SidebarBackgroundBrush}"
                                        CornerRadius="4" Padding="4,1,4,1"
                                        Visibility="{x:Bind ViewModel.HasFuzzyCorrections, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="✓ corrected" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.FuzzyDisplay, Mode=OneWay}"
                                       FontSize="11" FontFamily="Consolas"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Detected measures -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Detected measures" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.MeasuresDisplay, Mode=OneWay}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Pipeline explainer -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="How it works" Style="{StaticResource CaptionStyle}" />
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       LineHeight="18">
0. Tokenise      — stopwords, Porter stem
1. Bigram scan   — multi-word terms
2. Unigram lookup — 95 widget terms
3. Fuzzy fallback — Levenshtein for typos
4. Measure map   — keywords → system sensors
5. Layout logic  — deduce size &amp; preferred meter
6. Name gen      — generate a fitting title
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,10,32,10">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionStyle}" />
        </Border>

    </Grid>
</Page>
