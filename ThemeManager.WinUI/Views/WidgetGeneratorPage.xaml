<Page
    x:Class="ThemeManager.WinUI.Views.WidgetGeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="32,28,32,16">
            <StackPanel Spacing="2">
                <TextBlock Text="Widget Generator"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Describe the widget you want in plain English — the same offline NLP approach as the theme Vibe generator, just for measures and layout instead of color."
                           Style="{StaticResource CaptionStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,32">
            <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">

                <!-- Prompt input -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBox Text="{x:Bind ViewModel.PromptText, Mode=TwoWay}"
                                 PlaceholderText="e.g. &quot;a big CPU and memory graph in the top right&quot;"
                                 AcceptsReturn="False"
                                 FontSize="{StaticResource FontSizeSubtitle}" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SuggestionChips}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="200" MinItemHeight="36"
                                                   MinColumnSpacing="8" MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border CornerRadius="{StaticResource CornerRadiusPill}"
                                            Background="{StaticResource SidebarBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            Padding="14,7,14,7">
                                        <Button Background="Transparent" BorderThickness="0"
                                                Padding="0" Content="{x:Bind}"
                                                FontSize="12"
                                                Foreground="{StaticResource PrimaryAccentBrush}"
                                                Tag="{x:Bind}"
                                                Click="Chip_Click" />
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Button Content="Generate Widget"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanGenerate, Mode=OneWay}"
                                Click="GenerateButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Result / insights -->
                <Border Style="{StaticResource CardStyle}"
                        BorderBrush="{StaticResource PrimaryAccentBrush}"
                        BorderThickness="2"
                        Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.GeneratedSkin.Name, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeSubtitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <TextBlock Text="Detected measures:" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MeasuresDisplay, Mode=OneWay}"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                        <TextBlock Text="Matched words:" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MatchedWordsDisplay, Mode=OneWay}"
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.HasFuzzyCorrections, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Typo corrections:" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.FuzzyDisplay, Mode=OneWay}"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.UsedFallbackDisplay, Mode=OneWay}"
                                   Foreground="{StaticResource StrongAccentBrush}"
                                   TextWrapping="Wrap" />

                        <Button Content="Open in Editor to Customize"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OpenEditorButton_Click"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,10,32,10">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionStyle}" />
        </Border>

    </Grid>
</Page>
