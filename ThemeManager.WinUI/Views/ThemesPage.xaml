<Page
    x:Class="ThemeManager.WinUI.Views.ThemesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI.Views"
    xmlns:models="using:ThemeManager.Core.Models"
    Background="{StaticResource AppBackgroundBrush}">

    <!-- Converters declared FIRST so they are available during DataTemplate parsing -->
    <Page.Resources>
        <local:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolConverter       x:Key="InverseBoolConverter" />
        <local:HexToBrushConverter        x:Key="HexToBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Page header -->
            <RowDefinition Height="*" />      <!-- Theme grid  -->
            <RowDefinition Height="Auto" />   <!-- Status bar  -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             Page header
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Padding="32,28,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Themes"
                           FontSize="{StaticResource FontSizeDisplay}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Color palettes for the app and supported Windows accents. Themes change the look; they do not change your wallpaper or widget layout."
                           Style="{StaticResource CaptionStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Generate palette"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Click="GeneratePaletteButton_Click" />
            <Button Grid.Column="2"
                    x:Name="NewThemeButton"
                    Content="+ Blank theme"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center"
                    Click="NewThemeButton_Click" />
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             Theme grid – virtualized ItemsRepeater for performance
        ══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      Padding="32,0,32,32"
                      VerticalScrollBarVisibility="Auto">

            <ItemsRepeater x:Name="ThemesRepeater"
                           ItemsSource="{x:Bind ViewModel.Themes, Mode=OneWay}">

                <ItemsRepeater.Layout>
                    <UniformGridLayout ItemsStretch="Fill" MinItemWidth="340"
                                       MinColumnSpacing="16"
                                       MinRowSpacing="16" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:CozyTheme">

                        <!-- Theme Card -->
                        <Border Style="{StaticResource CardStyle}" Margin="0">

                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />  <!-- Palette strip -->
                                    <RowDefinition Height="Auto" />  <!-- Name + desc   -->
                                    <RowDefinition Height="Auto" />  <!-- Actions       -->
                                </Grid.RowDefinitions>

                                <!-- Palette colour strip (backgrounds set from code-behind via ElementPrepared) -->
                                <Grid Grid.Row="0"
                                      Height="12"
                                      CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="6,0,0,6" />
                                    <Border Grid.Column="1" />
                                    <Border Grid.Column="2" />
                                    <Border Grid.Column="3" />
                                    <Border Grid.Column="4" CornerRadius="0,6,6,0" />
                                </Grid>

                                <!-- Name, description, built-in badge -->
                                <StackPanel Grid.Row="1" Spacing="4">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" Height="48" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"
                                                   FontSize="{StaticResource FontSizeSubtitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Visibility="{x:Bind IsBuiltIn, Mode=OneTime,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                                HorizontalAlignment="Left" Background="{StaticResource SidebarBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2,6,2">
                                            <TextBlock Text="Built-in"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description, Mode=OneTime}" Height="48" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Description}"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Action buttons — Tag="{x:Bind}" passes the CozyTheme instance reliably -->
                                <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Content="Set Active"
                                            Tag="{x:Bind}"
                                            Click="SetActiveButton_Click"
                                            Style="{StaticResource PrimaryButtonStyle}" />

                                    <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Content="Edit"
                                            Tag="{x:Bind}"
                                            Click="EditButton_Click" />

                                    <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Content="Duplicate"
                                            Tag="{x:Bind}"
                                            Click="DuplicateButton_Click" />

                                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Content="Delete"
                                            Tag="{x:Bind}"
                                            Click="DeleteButton_Click"
                                            IsEnabled="{x:Bind IsBuiltIn, Mode=OneTime,
                                                Converter={StaticResource InverseBoolConverter}}"
                                            Padding="14,8,14,8" />
                                </Grid>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>

            </ItemsRepeater>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════
             Status bar
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,10,32,10">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                       Style="{StaticResource CaptionStyle}" />
        </Border>

    </Grid>
</Page>
