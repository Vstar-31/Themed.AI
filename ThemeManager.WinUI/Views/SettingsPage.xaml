<Page
    x:Class="ThemeManager.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer Padding="32,28,32,32"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="4" Margin="{StaticResource SectionMargin}">
                <TextBlock Text="Settings"
                           FontSize="{StaticResource FontSizeDisplay}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="App preferences, theme automation, backup, and diagnostics."
                           Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <!-- General -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" />

                    <ToggleSwitch x:Name="StartupToggle"
                                  Header="Launch at startup"
                                  Style="{StaticResource CozyToggleStyle}"
                                  Toggled="StartupToggle_Toggled" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Active Theme" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="ActiveThemeName"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryAccentBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup & Restore -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Backup &amp; Restore" Style="{StaticResource SectionHeaderStyle}" />

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               TextWrapping="Wrap">
                        Export all your themes to a single JSON file, or import a previously
                        exported backup to restore them on a new machine.
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Export All Themes…"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="ExportButton_Click" />

                        <Button Content="Import Theme…"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="ImportButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Theme Automation -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Theme Automation" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap">
                        Let Themed.AI switch your active theme on its own. If more than one rule
                        below is on at once, Battery Saver wins first, then weather, then Light/Dark
                        following, then the time-of-day schedule. Leave any theme picker at
                        "— Not set —" to skip that rule.
                    </TextBlock>

                    <ToggleSwitch x:Name="AutomationEnabledToggle"
                                  Header="Enable automation"
                                  Style="{StaticResource CozyToggleStyle}" />

                    <StackPanel Spacing="10">
                        <TextBlock Text="Time of day" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Sunrise" Style="{StaticResource CaptionStyle}" />
                                <TimePicker x:Name="SunriseTimePicker" ClockIdentifier="24HourClock"
                                            HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Theme" Style="{StaticResource CaptionStyle}" />
                                <ComboBox x:Name="SunriseThemeCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Noon" Style="{StaticResource CaptionStyle}" />
                                <TimePicker x:Name="NoonTimePicker" ClockIdentifier="24HourClock"
                                            HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Theme" Style="{StaticResource CaptionStyle}" />
                                <ComboBox x:Name="NoonThemeCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Dusk" Style="{StaticResource CaptionStyle}" />
                                <TimePicker x:Name="DuskTimePicker" ClockIdentifier="24HourClock"
                                            HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Theme" Style="{StaticResource CaptionStyle}" />
                                <ComboBox x:Name="DuskThemeCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Midnight" Style="{StaticResource CaptionStyle}" />
                                <TimePicker x:Name="MidnightTimePicker" ClockIdentifier="24HourClock"
                                            HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Theme" Style="{StaticResource CaptionStyle}" />
                                <ComboBox x:Name="MidnightThemeCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Follow Windows light/dark mode" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <ToggleSwitch x:Name="FollowLightDarkToggle"
                                      Header="Switch theme when Windows does"
                                      Style="{StaticResource CozyToggleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel Spacing="4" Width="180">
                                <TextBlock Text="Light theme" Style="{StaticResource CaptionStyle}" />
                                <ComboBox x:Name="LightThemeCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="4" Width="180">
                                <TextBlock Text="Dark theme" Style="{StaticResource CaptionStyle}" />
                                <ComboBox x:Name="DarkThemeCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Battery saver" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <ToggleSwitch x:Name="BatterySaverToggle"
                                      Header="Switch theme when Windows Battery Saver turns on"
                                      Style="{StaticResource CozyToggleStyle}" />
                        <StackPanel Spacing="4" Width="180">
                            <TextBlock Text="Battery saver theme" Style="{StaticResource CaptionStyle}" />
                            <ComboBox x:Name="BatterySaverThemeCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Crossfade duration (seconds)" Style="{StaticResource CaptionStyle}" />
                        <NumberBox x:Name="CrossfadeSecondsBox"
                                   SpinButtonPlacementMode="Compact"
                                   Minimum="0" Maximum="5" SmallChange="0.5"
                                   HorizontalAlignment="Left" Width="120" />
                    </StackPanel>

                    <Button Content="Save Automation Settings"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveAutomationButton_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Weather Settings (OpenWeatherMap) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Weather Settings" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap">
                        Connect your OpenWeatherMap API key and city so Themed.AI can
                        automatically switch themes based on current weather conditions.
                        Get a free API key at openweathermap.org.
                    </TextBlock>

                    <ToggleSwitch x:Name="WeatherReactiveToggle"
                                  Header="Switch theme with the current weather"
                                  Style="{StaticResource CozyToggleStyle}" />

                    <ToggleSwitch x:Name="WeatherDynamicLocationToggle"
                                  Header="Use dynamic location (Windows Location Services)"
                                  Style="{StaticResource CozyToggleStyle}"
                                  Toggled="WeatherDynamicLocationToggle_Toggled" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel Spacing="4" Width="180">
                            <TextBlock Text="City" Style="{StaticResource CaptionStyle}" />
                            <TextBox x:Name="WeatherCityBox" PlaceholderText="e.g. Jaipur,IN" />
                        </StackPanel>
                        <StackPanel Spacing="4" Width="180">
                            <TextBlock Text="OpenWeatherMap API key" Style="{StaticResource CaptionStyle}" />
                            <PasswordBox x:Name="WeatherApiKeyBox" PasswordRevealMode="Peek" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Theme per condition" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Clear" Style="{StaticResource CaptionStyle}" />
                            <ComboBox x:Name="WeatherClearThemeCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Clouds" Style="{StaticResource CaptionStyle}" />
                            <ComboBox x:Name="WeatherCloudsThemeCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <TextBlock Text="Rain / drizzle" Style="{StaticResource CaptionStyle}" />
                            <ComboBox x:Name="WeatherRainThemeCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Thunderstorm" Style="{StaticResource CaptionStyle}" />
                            <ComboBox x:Name="WeatherThunderstormThemeCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Snow" Style="{StaticResource CaptionStyle}" />
                            <ComboBox x:Name="WeatherSnowThemeCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                            <TextBlock Text="Fog / haze / mist" Style="{StaticResource CaptionStyle}" />
                            <ComboBox x:Name="WeatherFogThemeCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Save Weather Settings"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveWeatherButton_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeaderStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="App version"
                                   Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="1.0.0-preview"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Data folder"
                                   Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   x:Name="DataFolderText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text=".NET runtime"
                                   Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   x:Name="RuntimeText"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Button Content="Open Data Folder"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OpenDataFolderButton_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        Themed.AI — a lightweight, modular Windows 11 theme manager.
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               TextWrapping="Wrap">
                        Built with WinUI 3, Windows App SDK, and .NET 8.
                        Open-source under the MIT license.
                        No telemetry. No ads. No cloud required.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Status -->
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource CaptionStyle}" />

        </StackPanel>
    </ScrollViewer>
</Page>
