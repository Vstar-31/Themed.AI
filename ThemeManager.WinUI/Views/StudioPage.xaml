<Page
    x:Class="ThemeManager.WinUI.Views.StudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ThemeManager.WinUI.Views"
    mc:Ignorable="d"
    Loaded="StudioPage_ActiveStateLoaded"
    Unloaded="StudioPage_ActiveStateUnloaded">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="StudioWorldListItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="DESKTOP STUDIO" FontSize="12" FontWeight="SemiBold" Opacity="0.65" />
                    <TextBlock Text="Build your world" FontSize="36" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="Compose wallpapers, widgets, atmosphere and Windows personality as one living scene." FontSize="14" Opacity="0.72" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Surprise me" Click="SurpriseMe_Click" Margin="0,0,8,0" />
                    <Button Content="Generate world" Click="GenerateWorld_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="18" Padding="18" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="WORLDS" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=ScenesList, Path=Items.Count, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <ListView x:Name="ScenesList" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="ScenesList_SelectionChanged" ItemContainerStyle="{StaticResource StudioWorldListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryAccentBrush}" />
                                                    <TextBlock Text="ACTIVE" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryAccentBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WidgetCount}" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="widgets" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="SetActiveWorldButton"
                                Grid.Row="2"
                                Content="Activate this world"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0"
                                Padding="14,10"
                                Click="SetSelectedWorldActive_Click" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" CornerRadius="22" Padding="28" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="ACTIVE WORLD" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="ActiveSceneName" Text="No world selected" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            <TextBlock x:Name="ActiveSceneMeta" Text="Select a world to preview its composition." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                            <Grid Margin="0,14,0,0" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch x:Name="AutoSwitchToggle"
                                              Header="Vibe auto-switch"
                                              IsOn="False"
                                              Toggled="AutoSwitchToggle_Toggled"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="AutoSwitchStatusText"
                                           Grid.Column="1"
                                           Text="Manual world selection only."
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Margin="0,24,0,18">
                            <StackPanel x:Name="SceneDetails" Spacing="10" />
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16" Background="{StaticResource SidebarBackgroundBrush}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="THEMED WALLPAPER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Generate a wallpaper from the active theme palette and bind it to this desktop world. Everything runs locally and is free." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ComboBox Grid.Column="0" x:Name="WallpaperStyleCombo" Header="Style" ItemsSource="{x:Bind WallpaperStyles}" SelectedIndex="0" />
                                    <ComboBox Grid.Column="1" x:Name="WallpaperSizeCombo" Header="Resolution" ItemsSource="{x:Bind WallpaperSizes}" SelectedIndex="0" />

                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="WallpaperNameBox" Header="Name" PlaceholderText="World wallpaper" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8">
                                        <Button Content="Generate" Click="GenerateWallpaper_Click" />
                                        <Button Content="Generate + Apply" Click="GenerateAndApplyWallpaper_Click" />
                                    </StackPanel>
                                </Grid>

                                <Button Content="Apply last generated wallpaper" Click="ApplyLastWallpaper_Click" HorizontalAlignment="Left" />
                                <TextBlock x:Name="WallpaperStatusText" Text="Ready — generated wallpapers follow the active theme palette." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="ApplyStatus" Text="Ready" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="A world restores its saved widget layout and wallpaper together." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Save current layout" Click="SaveCurrentLayout_Click" />
                            <Button Grid.Column="2" Content="Duplicate" Click="DuplicateWorld_Click" />
                            <Button Grid.Column="3" Content="Delete" Style="{StaticResource DangerButtonStyle}" Click="DeleteWorld_Click" />
                            <Button Grid.Column="4" Content="Apply to desktop" Click="ApplyScene_Click" Padding="20,10" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" Text="THEMED.AI  •  Desktop worlds are the new skins" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Opacity="0.75" FontSize="11" Margin="0,18,0,0" />
        </Grid>
    </ScrollViewer>
</Page>