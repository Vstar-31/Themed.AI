<Page x:Class="ThemeManager.WinUI.Views.StudioPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppBackgroundBrush}"><Grid Padding="28" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Spacing="4"><TextBlock Text="Studio" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Design the whole desktop as one living world." Style="{StaticResource CaptionStyle}"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10"><Button Content="✦ Generate world" Style="{StaticResource PrimaryButtonStyle}" Click="GenerateWorld_Click"/><Button Content="Surprise me" Style="{StaticResource GhostButtonStyle}" Click="SurpriseMe_Click"/></StackPanel></Grid><Grid Grid.Row="1" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" CornerRadius="24" Background="{StaticResource StrongAccentBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="20"><Border CornerRadius="18" Background="#25000000" BorderBrush="#44FFFFFF" BorderThickness="1" Padding="28"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"><TextBlock Text="DESKTOP WORLD" FontSize="11" FontWeight="SemiBold" Foreground="#AAFFFFFF" HorizontalAlignment="Center"/><TextBlock x:Name="HeroTitle" Text="Your desktop, reimagined." FontSize="34" FontWeight="SemiBold" Foreground="White" TextAlignment="Center"/><TextBlock x:Name="HeroDescription" Text="Scenes unify themes, widgets, wallpaper, effects and VibeFinder context." TextWrapping="Wrap" MaxWidth="620" Foreground="#CCFFFFFF" TextAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0"><Border CornerRadius=