<Window
    x:Class="ThemeManager.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI"
    Title="Themed.AI">
    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Padding="20,0,0,0" Spacing="10">
                <Border Width="32" Height="32" CornerRadius="{StaticResource CornerRadiusSmall}" Background="{StaticResource PrimaryAccentBrush}"><TextBlock Text="☕" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="Themed.AI" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="12,8,12,8" Spacing="4">
                    <TextBlock Text="MAKE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="12,4,0,4" />
                    <Button x:Name="NavStudio" Content="✦  Studio" Style="{StaticResource NavItemStyle}" Click="NavStudio_Click"/>
                    <Button x:Name="NavThemes" Content="🎨  Themes" Style="{StaticResource NavItemActiveStyle}" Click="NavThemes_Click"/>
                    <Button x:Name="NavWidgets" Content="🧩  Widgets" Style="{StaticResource NavItemStyle}" Click="NavWidgets_Click"/>
                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="10,12,10,8" />
                    <TextBlock Text="MORE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,4" />
                    <Button x:Name="NavMore" Content="More tools" Style="{StaticResource NavItemStyle}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Right">
                                <MenuFlyoutItem Text="Desktop World (advanced)" Click="NavWorld_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Generate a theme palette" Click="NavVibe_Click" />
                                <MenuFlyoutItem Text="Widget generator" Click="NavWidgetVibe_Click" />
                                <MenuFlyoutItem Text="Theme preview / editor" Click="NavPreview_Click" />
                                <MenuFlyoutItem Text="Windows and system integration" Click="NavSystem_Click" />
                                <MenuFlyoutItem Text="Gallery" Click="NavGallery_Click" />
                                <MenuFlyoutItem Text="VibeFinder AI" Click="NavVibeFinderAI_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Settings" Click="NavSettings_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="v1.0.0-preview · desktop rehaul" Style="{StaticResource CaptionStyle}" Margin="20,0,20,16" VerticalAlignment="Bottom"/>
        </Grid>
        <Rectangle Grid.Column="1" Fill="{StaticResource BorderSubtleBrush}"/>
        <Frame x:Name="ContentFrame" Grid.Column="2" Background="{StaticResource AppBackgroundBrush}"/>
        <WebView2 x:Name="VibeFinderPrewarmWebView" Grid.ColumnSpan="3" Width="0" Height="0" Visibility="Collapsed"/>
    </Grid>
</Window>
