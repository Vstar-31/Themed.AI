<Window
    x:Class="ThemeManager.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ThemeManager.WinUI"
    Title="Themed.AI">
    <ContentControl x:Name="StartupContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SidebarToggleButton"
                        Grid.Column="0"
                        Content="☰"
                        Width="36" Height="36"
                        Padding="0"
                        ToolTipService.ToolTip="Collapse or expand sidebar"
                        Click="SidebarToggle_Click"
                        VerticalAlignment="Center"
                        Style="{StaticResource GhostButtonStyle}" />
                <StackPanel Grid.Column="1" x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center" Padding="10,0,0,0" Spacing="8">
                    <Border Width="32" Height="32" CornerRadius="{StaticResource CornerRadiusSmall}" Background="{StaticResource PrimaryAccentBrush}"><TextBlock Text="☕" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="BrandTitle" Text="Themed.AI" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="8,8,8,8" Spacing="4">
                    <TextBlock x:Name="MakeHeader" Text="MAKE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="12,4,0,4" />
                    <Button x:Name="NavStudio" Content="✦  Studio" ToolTipService.ToolTip="Studio — build desktop worlds" Style="{StaticResource NavItemStyle}" Click="NavStudio_Click"/>
                    <Button x:Name="NavThemes" Content="🎨  Themes" ToolTipService.ToolTip="Themes — color palettes" Style="{StaticResource NavItemActiveStyle}" Click="NavThemes_Click"/>
                    <Button x:Name="NavWidgets" Content="🧩  Widgets" ToolTipService.ToolTip="Widgets — add and manage desktop tools" Style="{StaticResource NavItemStyle}" Click="NavWidgets_Click"/>
                    <Button x:Name="NavVibeFinderAI" Content="🎵  VibeFinder AI" ToolTipService.ToolTip="VibeFinder AI — music and prompt integration" Style="{StaticResource NavItemStyle}" Click="NavVibeFinderAI_Click"/>
                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="10,12,10,8" />
                    <Button x:Name="NavMore" Content="⌄  More tools" ToolTipService.ToolTip="Expand or collapse more tools" Style="{StaticResource NavItemStyle}" Click="NavMore_Click"/>
                    <StackPanel x:Name="MoreToolsPanel" Visibility="Collapsed" Spacing="3" Margin="0,2,0,0">
                        <Button x:Name="NavWorld" Content="◈  Desktop World" ToolTipService.ToolTip="Advanced desktop world controls" Style="{StaticResource NavItemStyle}" Click="NavWorld_Click"/>
                        <Button x:Name="NavVibe" Content="✨  Palette generator" ToolTipService.ToolTip="Generate a theme palette" Style="{StaticResource NavItemStyle}" Click="NavVibe_Click"/>
                        <Button x:Name="NavWidgetVibe" Content="🪄  Widget generator" ToolTipService.ToolTip="Generate a widget from a description" Style="{StaticResource NavItemStyle}" Click="NavWidgetVibe_Click"/>
                        <Button x:Name="NavPreview" Content="◉  Preview / editor" ToolTipService.ToolTip="Theme preview and editor" Style="{StaticResource NavItemStyle}" Click="NavPreview_Click"/>
                        <Button x:Name="NavSystem" Content="⚙  System" ToolTipService.ToolTip="Windows and system integration" Style="{StaticResource NavItemStyle}" Click="NavSystem_Click"/>
                        <Button x:Name="NavGallery" Content="▦  Gallery" ToolTipService.ToolTip="Theme and widget gallery" Style="{StaticResource NavItemStyle}" Click="NavGallery_Click"/>
                        <Button x:Name="NavSettings" Content="🔧  Settings" ToolTipService.ToolTip="App settings" Style="{StaticResource NavItemStyle}" Click="NavSettings_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="SidebarFooter" Grid.Row="2" Text="v1.0.0-preview · desktop rehaul" Style="{StaticResource CaptionStyle}" Margin="12,0,12,16" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
        </Grid>
        <Rectangle Grid.Column="1" Fill="{StaticResource BorderSubtleBrush}"/>
        <Frame x:Name="ContentFrame" Grid.Column="2" Background="{StaticResource AppBackgroundBrush}"/>
        <WebView2 x:Name="VibeFinderPrewarmWebView" Grid.ColumnSpan="3" Width="0" Height="0" Visibility="Collapsed"/>
    </Grid>
    </ContentControl></Window>
