<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Windows.UI">

    <!-- ═══════════════════════════════════════════════════════════════════════
         COZY CAFÉ — Default Palette
         Warm, soft, but intentionally high-contrast. Runtime theming updates
         the same brush instances so StaticResource consumers repaint live.
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Raw colors -->
    <ui:Color x:Key="ColorBackgroundBase">#F7F3EE</ui:Color>
    <ui:Color x:Key="ColorBackgroundAlt">#E8DDD1</ui:Color>
    <ui:Color x:Key="ColorSurface">#C6AA92</ui:Color>
    <ui:Color x:Key="ColorAccentPrimary">#6A4937</ui:Color>
    <ui:Color x:Key="ColorAccentStrong">#3D2A21</ui:Color>
    <ui:Color x:Key="ColorTextPrimary">#241A15</ui:Color>
    <ui:Color x:Key="ColorTextMuted">#5D5048</ui:Color>
    <ui:Color x:Key="ColorBorderSubtle">#CDBEAE</ui:Color>

    <!-- Derived hover/pressed tints -->
    <ui:Color x:Key="ColorSurfaceHover">#D8C2AE</ui:Color>
    <ui:Color x:Key="ColorSurfacePressed">#B39176</ui:Color>
    <ui:Color x:Key="ColorOverlaySubtle">#18000000</ui:Color>

    <!-- ── SolidColorBrushes ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorBackgroundBase}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource ColorBackgroundAlt}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource ColorBackgroundBase}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="StrongAccentBrush" Color="{StaticResource ColorAccentStrong}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource ColorSurfacePressed}" />
    <SolidColorBrush x:Key="OverlaySubtleBrush" Color="{StaticResource ColorOverlaySubtle}" />

    <!-- Dynamically selected readable text tones. App.ApplyThemeToResources keeps
         these in sync with SurfaceBrush/PrimaryAccentBrush when a theme changes. -->
    <SolidColorBrush x:Key="TextOnSurfaceBrush" Color="#241A15" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Convenience aliases used by WinUI's default control styles -->
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush"
                     Color="{StaticResource ColorTextPrimary}" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         GEOMETRY TOKENS
    ═══════════════════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="CornerRadiusLarge">16,16,16,16</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">12,12,12,12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">8,8,8,8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusPill">999,999,999,999</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SPACING TOKENS
    ═══════════════════════════════════════════════════════════════════════ -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">24</x:Double>
    <x:Double x:Key="Space6">32</x:Double>
    <x:Double x:Key="Space7">48</x:Double>

    <Thickness x:Key="CardPadding">20,16,20,16</Thickness>
    <Thickness x:Key="SectionMargin">0,0,0,16</Thickness>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TYPOGRAPHY
    ═══════════════════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeDisplay">28</x:Double>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CONTROL STYLES
    ═══════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Background" Value="{StaticResource StrongAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
        <Setter Property="Padding" Value="20,10,20,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#B3261E" />
        <Setter Property="BorderBrush" Value="#B3261E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="NavItemStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
        <Setter Property="Padding" Value="16,10,16,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="NavItemActiveStyle" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnSurfaceBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ColorChipStyle" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Keep list/control text independent from Windows' light/dark system theme. -->
    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CozyTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Background" Value="{StaticResource SidebarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="Padding" Value="10,8,10,8" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="CozyToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

</ResourceDictionary>