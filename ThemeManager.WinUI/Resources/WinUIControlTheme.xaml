<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WinUI stock control palettes must follow Themed.AI's light/cozy palette.
         ThemeResource keeps these aliases reactive when App.ApplyThemeToResources updates
         the underlying color tokens at runtime. -->

    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{ThemeResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="{ThemeResource ColorTextMuted}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="{ThemeResource ColorTextMuted}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="{ThemeResource ColorTextMuted}" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource ColorTextMuted}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{ThemeResource ColorTextMuted}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{ThemeResource ColorTextMuted}" Opacity="0.45" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{ThemeResource ColorBackgroundAlt}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{ThemeResource ColorBackgroundBase}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{ThemeResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{ThemeResource ColorBackgroundAlt}" Opacity="0.55" />

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{ThemeResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{ThemeResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{ThemeResource ColorAccentPrimary}" />

    <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource ColorTextMuted}" Opacity="0.45" />
    <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource ColorSurface}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource ColorSurfacePressed}" />

    <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource ColorTextMuted}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource ColorBorderSubtle}" />

    <SolidColorBrush x:Key="ComboBoxForeground" Color="{ThemeResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="ComboBoxPlaceholderForeground" Color="{ThemeResource ColorTextMuted}" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{ThemeResource ColorTextPrimary}" />

</ResourceDictionary>
